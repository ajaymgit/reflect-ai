PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/reflectai
JWT_SECRET=replace_with_secure_value
# Chat and Retrospect try every provider below that's actually configured,
# in this order: Ollama -> Gemini -> OpenAI (see chat/service.js and
# retrospect/service.js). You don't have to pick just one -- fill in as many
# as you want as a real fallback chain. Leaving a key as its
# "replace_with_..." placeholder is treated as unset, not a broken key.
OPENAI_API_KEY=replace_with_openai_key
GEMINI_API_KEY=replace_with_gemini_key
# Per-provider model overrides -- optional, each defaults to a cheap model
# (gpt-4.1-mini / gemini-2.0-flash) if unset. AI_MODEL is a legacy override
# that applies to whichever of these isn't set individually.
OPENAI_MODEL=
GEMINI_MODEL=
AI_MODEL=gemini-2.0-flash
USE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Only needed if OLLAMA_BASE_URL points at Ollama's hosted API
# (https://ollama.com) instead of a local/self-hosted instance -- get one at
# https://ollama.com/settings/keys. Leave unset for a local Ollama instance,
# which doesn't check for an Authorization header at all.
OLLAMA_API_KEY=
CLIENT_URL=http://localhost:5173
DEMO_EMAIL=demo@reflectai.com
DEMO_PASSWORD=Demo@123
# Password reset emails (POST /api/auth/forgot-password). Get a key at
# https://resend.com -- without one, reset links are logged server-side
# instead of emailed, so the app still runs fine without this set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ReflectAI <onboarding@resend.dev>
# Encrypts journal content and health metrics at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace_with_secure_value
# Only set this if the server runs behind a reverse proxy / load balancer
# (Nginx, Render, Fly.io, Heroku, etc) -- set to "1" if there's exactly one
# proxy in front of it. Leave unset for local/direct use, otherwise every
# rate limiter (login, refresh, forgot-password, 2FA) ends up keyed by the
# proxy's IP instead of the real client's.
TRUST_PROXY=

